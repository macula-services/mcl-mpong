{application, mcl_mpong, [
    {description, "Two bots play pong over the mesh, and the match reports how the mesh carried it"},
    {vsn, "0.1.0"},
    {registered, [mcl_mpong_sup]},
    {mod, {mcl_mpong_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        %% Mesh SDK, realm identity, capabilities, health.
        mcl_om
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/macula-services/mcl-mpong"}]}
]}.
